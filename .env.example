# Copy this file to `.env` (same folder) and fill in your key.
# `.env` is gitignored — never commit it.

# ---------------------------------------------------------------- required --

# Anthropic API key. This is API credit from https://console.anthropic.com,
# billed per request. A Claude Pro/Max subscription is a DIFFERENT thing and
# does not work here.
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------- optional --

# ElevenLabs gives Clicky a much better voice than the built-in Windows one.
# Leave these out and Clicky speaks with the Windows voice instead, which needs
# no account and no download. https://elevenlabs.io
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=kPzsL2i3teMYv0FxEYQ6

# Which Microsoft Edge neural voice to speak with. This is the default voice
# and needs no account or key. Good options:
#   en-GB-SoniaNeural (default, British female)   en-GB-RyanNeural (British male)
#   en-US-AriaNeural  (American female)           en-US-GuyNeural  (American male)
# Set to "off" to disable Edge and stay fully offline (Clicky then uses the
# Windows voice, which is robotic). Note: Edge speech sends the spoken reply
# text to Microsoft — not your prompt, and not your screenshots.
# CLICKY_EDGE_VOICE=en-GB-SoniaNeural

# Which Windows voice to use when Edge is off or unreachable. List them with:
#   powershell -c "Add-Type -AssemblyName System.Speech; (New-Object System.Speech.Synthesis.SpeechSynthesizer).GetInstalledVoices().VoiceInfo.Name"
# Default is the system voice (usually David). "Zira" is the female one.
# CLICKY_WINDOWS_VOICE=Zira

# Use the on-device Kokoro neural voice instead of the Windows one. It sounds
# far better but needs a capable GPU: measured at ~10s per sentence on an Intel
# Arc 140V, which is too slow to be usable. Only worth it on discrete graphics.
# CLICKY_LOCAL_VOICE=kokoro

# Route everything through a Cloudflare Worker instead of calling the APIs
# directly. Only needed if you want to share this app with other people — see
# worker/ and the README. When set, no local API key is required.
# CLICKY_WORKER_URL=https://clicky-proxy.your-subdomain.workers.dev
